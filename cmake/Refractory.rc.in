// Generated from cmake/Refractory.rc.in - shows up under the exe's Properties > Details.
#include <winver.h>

// The app icon (res/Refractory.ico, drawn by tools/make_icon.py). Explorer shows the exe's first
// icon, and GLFW gives its windows the one named GLFW_ICON (title bar, taskbar, Alt+Tab).
GLFW_ICON ICON "@CMAKE_SOURCE_DIR@/res/Refractory.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Refractory node-based image editor"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "ProductName", "Refractory"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
            VALUE "OriginalFilename", "Refractory.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
